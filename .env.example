# Receipts: every setting, in one file at the repo root (all apps read it).
# Copy to .env and fill in what you have. With nothing set, `pnpm dev` runs everything locally:
# PGlite database, in-memory chain, simulated proofs, mock humans, no payments, rule-based structuring.
# Each integration switches on when its keys are present; the API logs what is on at startup.

# ---------------------------------------------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------------------------------------------
# NODE_ENV=production turns off demo data, simulated proofs, mock identity and in-process jobs, and requires
# SESSION_SECRET. Leave unset for local work.
# NODE_ENV=production
PORT=8787
PUBLIC_API_URL=http://localhost:8787
PUBLIC_WEB_URL=http://localhost:3000
# The business app is served at /business on the reviewer site (one origin, so one account and one sign-in); the
# reviewer site proxies it from its own server, BUSINESS_ZONE_URL (default http://localhost:3001).
PUBLIC_MERCHANT_URL=http://localhost:3000/business
# BUSINESS_ZONE_URL=http://localhost:3001
PUBLIC_DEMO_URL=http://localhost:3002/stage
PUBLIC_ADMIN_URL=http://localhost:3003/admin
# Extra browser origins allowed to call the API (comma-separated).
# CORS_ORIGINS=

# Unset: PGlite in .data/. Production: Postgres 15+ with PostGIS and pgvector (infra/docker-compose.yml).
# DATABASE_URL=postgres://receipts:receipts@localhost:5432/receipts
# DATABASE_URL=pglite:memory
# Supabase on Vercel: the Transaction pooler string (port 6543; the direct host is IPv6 only), ending in
# ?sslmode=no-verify, since node-postgres verifies sslmode=require in full and Supabase signs with its own CA.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=no-verify
# Or verify it: Supabase's CA (Database settings > SSL) as PEM, newlines written as \n; sslmode is then ignored.
# DATABASE_CA_CERT=
# DATABASE_POOL_SIZE=10
# PGLITE_DEBUG=1                 # print Postgres's own log (why a PGlite database will not open)

# Required in production: 32+ random characters (openssl rand -hex 32). Signs every session.
# SESSION_SECRET=
# 32 bytes (hex or base64) for AES-GCM over stored proofs and voice notes. Derived from SESSION_SECRET when unset.
# DATA_ENCRYPTION_KEY=
# Protects /v1/admin (stage controls, flag decisions). Unset locally = open; unset in production = disabled.
# ADMIN_TOKEN=                  # the admin console (apps/admin) asks for it; without one, admin routes are open locally
# Vercel Cron sends it as a Bearer token to /v1/cron/:minutes (the jobs on a deployment). Unset: that route is closed.
# CRON_SECRET=

# Development switches (default on unless NODE_ENV=production)
# DEMO_MODE=true                 # labelled simulated history, demo controls, test affiliate network
# ALLOW_SIMULATED_PROOFS=true    # the labelled dev rail
# ALLOW_MOCK_IDENTITY=true       # labelled mock humans for rehearsals
# RUN_WORKER_IN_PROCESS=true     # cron jobs inside the API (PGlite has one owner)
# DEMO_CACHE_ANSWERS=false       # reuse answers to repeated stage questions (payment still runs live)

# ---------------------------------------------------------------------------------------------------------------
# Chain: Base Sepolia for the event. RELAYER_PRIVATE_KEY alone switches CHAIN to base-sepolia.
# ---------------------------------------------------------------------------------------------------------------
# CHAIN=base-sepolia             # base-sepolia | base | local | off
# BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# BASE_RPC_URL=https://mainnet.base.org
# Pays gas for delegated attestations and gasless claims. Fund with Base Sepolia ETH.
# RELAYER_PRIVATE_KEY=
# Registers humans, attests merchants, posts payout roots. Defaults to the relayer.
# OPERATOR_PRIVATE_KEY=
# TREASURY_ADDRESS=
# Contract deployment (pnpm contracts:deploy). Refuses mainnet without --i-know-this-is-mainnet.
# DEPLOYER_PRIVATE_KEY=
# OPERATOR_ADDRESS=

# ---------------------------------------------------------------------------------------------------------------
# x402 (agents pay per call in USDC). On by default with a real chain.
# ---------------------------------------------------------------------------------------------------------------
# X402_MODE=on
# X402_FACILITATOR_URL=https://x402.org/facilitator
# X402_NETWORK=eip155:84532
# X402_PAY_TO=                   # defaults to TREASURY_ADDRESS, then the operator
# AGENT_DAILY_CAP_USDC=1.00      # server-side cap per paying wallet

# The demo agent and the MCP bridge (they pay from this wallet; fund it with Base Sepolia USDC).
# AGENT_PRIVATE_KEY=
# AGENT_NETWORK=eip155:84532
# AGENT_BUDGET_USDC=0.05
# AGENT_MAX_PER_CALL_USDC=0.01
# AGENT_LLM=anthropic            # anthropic | gemini | openai-compat | offline (both demo agents use the same model)
# RECEIPTS_API_URL=http://localhost:8787
# Stage app: when set, the operator enters it once before running agents or the attack.
# DEMO_TOKEN=

# ---------------------------------------------------------------------------------------------------------------
# One human
# ---------------------------------------------------------------------------------------------------------------
# SELF_SCOPE=receipts-v1         # at most 31 characters
# SELF_ENDPOINT=https://api.example.com/v1/self/verify   # must be public HTTPS; defaults to PUBLIC_API_URL
# SELF_MOCK_PASSPORT=true        # Self staging and mock passports (default on outside production)
# ANON_AADHAAR_NULLIFIER_SEED=4534
# ANON_AADHAAR_TEST_MODE=true    # test QR codes (default on outside production)

# ---------------------------------------------------------------------------------------------------------------
# Proof rails
# ---------------------------------------------------------------------------------------------------------------
# Places: Google Maps Platform (Places API (New) and Maps Static API), server-side only. Without it, a UPI payment is
# reviewed under the payee name and businesses can only claim listings already on Receipts.
# GOOGLE_MAPS_API_KEY=

# Reclaim (order pages and payment proofs): app at dev.reclaimprotocol.org
# RECLAIM_APP_ID=
# RECLAIM_APP_SECRET=
# Provider IDs, set after testing each on two phones (docs/providers.md lists what each proves)
# RECLAIM_PROVIDER_SWIGGY=8aac5893-f43b-4fd9-ad26-ae266da258d2    # community "Swiggy Last Order Details"
# RECLAIM_PROVIDER_BLINKIT=675fa687-4e5b-45ec-b560-ec8cd61174eb   # community "Blinkit Last 3 Orders"
# RECLAIM_PROVIDER_ZOMATO=
# RECLAIM_PROVIDER_AMAZON=
# RECLAIM_PROVIDER_UPI=
# RECLAIM_PROVIDER_SWIGGY_PARTNER=                               # not read yet
# ZK Email blueprints (order emails proved on the phone); without them the .eml upload path is used
# ZKEMAIL_BLUEPRINT_SWIGGY=
# ZKEMAIL_BLUEPRINT_ZOMATO=
# ZKEMAIL_BLUEPRINT_AMAZON=
# ONDC_REGISTRY_URL=https://prod.registry.ondc.org/v2.0/lookup

# ---------------------------------------------------------------------------------------------------------------
# Voice and language models
# ---------------------------------------------------------------------------------------------------------------
# SARVAM_API_KEY=
# SARVAM_MODEL=saaras:v3
# SARVAM_MODE=codemix
# LLM_PROVIDER=anthropic         # anthropic | gemini | openai-compat | offline; chosen from the keys present
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
# Any OpenAI-compatible endpoint, e.g. the free model keys AI Grants India (aigrants.in) issues, OpenRouter or Groq.
# All three must be set; use the base URL and model name the provider gives you (the URL usually ends in /v1). An
# AI Grants OpenAI key: https://api.openai.com/v1 and gpt-5-nano (set LLM_PROVIDER=openai-compat if Gemini or
# Anthropic keys are also present).
# OPENAI_COMPAT_BASE_URL=
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_MODEL=
# Read-aloud of published reviews and answers (Smallest AI Lightning text to speech; the key stays on the server).
# SMALLEST_API_KEY=

# ---------------------------------------------------------------------------------------------------------------
# Storage, trust graph
# ---------------------------------------------------------------------------------------------------------------
# PINATA_JWT=                    # pins review JSON to IPFS; content is served from the API either way
# PINATA_GATEWAY=
# TigerGraph Savanna: with only the organization API key set, `pnpm graph:setup` creates a database user, loads
# packages/engine/graph/*.gsql and writes TIGERGRAPH_HOST and TIGERGRAPH_SECRET here.
# TIGERGRAPH_API_KEY=            # Savanna > Admin settings > API keys (control plane; used only by graph:setup)
# TIGERGRAPH_HOST=https://your-instance.i.tgcloud.io
# TIGERGRAPH_GRAPH=Receipts
# TIGERGRAPH_SECRET=
# TIGERGRAPH_TOKEN=
# TIGERGRAPH_MCP_COMMAND=        # e.g. "uvx pytigergraph-mcp", gives the investigator agent graph tools

# ---------------------------------------------------------------------------------------------------------------
# Money in and out
# ---------------------------------------------------------------------------------------------------------------
# Shop-through: per-network postback secrets and link templates ({pub} {click} {url} {deeplink})
# AFFILIATE_PUBLISHER_ID=
# AFFILIATE_SECRET_CUELINKS=
# AFFILIATE_SECRET_ADMITAD=
# AFFILIATE_SECRET_INRDEALS=
# AFFILIATE_SECRET_DIRECT=
# AFFILIATE_SECRET_TEST=test-network-secret
# RazorpayX payouts (UPI) and the ₹1 merchant check; test mode keys at the event
# RAZORPAYX_KEY_ID=
# RAZORPAYX_KEY_SECRET=
# RAZORPAYX_ACCOUNT_NUMBER=      # your RazorpayX account in test mode (x.razorpay.com), not a shared test number
# RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_CLAIM_VPA=
# FX_INR_PER_USD=88
# Dodo Payments (cards: API credits, merchant plan)
# DODO_API_KEY=
# DODO_WEBHOOK_SECRET=
# DODO_ENV=test_mode
# DODO_PRODUCT_CREDITS=
# DODO_PRODUCT_MERCHANT_PRO=
# GST lookups for merchant claims
# GST_API_URL=
# GST_API_KEY=


# ---------------------------------------------------------------------------------------------------------------
# Notifications (check-in reminders)
# ---------------------------------------------------------------------------------------------------------------
# EXPO_ACCESS_TOKEN=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
# WHATSAPP_TEMPLATE=receipts_followup
# RESEND_API_KEY=
# EMAIL_FROM=Receipts <checkins@example.com>

# ---------------------------------------------------------------------------------------------------------------
# Apps (public values are inlined into the browser and phone bundles)
# ---------------------------------------------------------------------------------------------------------------
# PRIVY_APP_ID=                  # email/Google wallets on web; without it, a wallet kept in the browser
# EXPO_PUBLIC_API_URL=           # the phone app; defaults to the dev machine's address on port 8787
# EXPO_PUBLIC_WEB_URL=
# OVERPASS_URL=https://overpass-api.de/api/interpreter   # optional offline OSM import (places now come from Google)

# ---------------------------------------------------------------------------------------------------------------
# Tooling
# ---------------------------------------------------------------------------------------------------------------
# pnpm security:scan (a free socket.dev account: Settings > API tokens). Socket Firewall needs neither.
# SOCKET_CLI_API_TOKEN=
# SOCKET_CLI_ORG_SLUG=
