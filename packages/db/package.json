{
  "name": "@receipts/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SQL migrations, a Postgres client (pg in production, PGlite with PostGIS and pgvector locally) and seeds.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./seed": "./src/seed/index.ts"
  },
  "scripts": {
    "migrate": "tsx src/cli.ts migrate",
    "seed": "tsx src/cli.ts seed",
    "reset": "tsx src/cli.ts reset",
    "osm": "tsx scripts/osm-import.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@electric-sql/pglite-pgvector": "^0.0.12",
    "@electric-sql/pglite-postgis": "^0.2.11",
    "@receipts/brands": "workspace:*",
    "@receipts/categories": "workspace:*",
    "@receipts/core": "workspace:*",
    "pg": "^8.23.1",
    "viem": "^2.57.11"
  },
  "devDependencies": {
    "@types/pg": "^8.15.0"
  }
}
