{
  "name": "@receipts/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Receipts MCP over stdio (paid tools via x402), the local x402 HTTP bridge fallback, and the demo agent CLI.",
  "bin": {
    "receipts-mcp": "./src/stdio.ts"
  },
  "scripts": {
    "stdio": "tsx src/stdio.ts",
    "bridge": "tsx src/bridge.ts",
    "agent": "tsx src/agent-cli.ts",
    "smoke": "tsx scripts/smoke.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@receipts/agent": "workspace:*",
    "@receipts/core": "workspace:*",
    "@receipts/engine": "workspace:*",
    "@x402/core": "^2.28.0",
    "@x402/evm": "^2.28.0",
    "@x402/fetch": "^2.28.0",
    "viem": "^2.57.11",
    "zod": "^4.6.7"
  }
}
