    "@receipts/engine": "workspace:*",
    "@receipts/rails": "workspace:*",
    "@x402/core": "^2.28.0",
    "@x402/evm": "^2.28.0",
    "@x402/hono": "^2.28.0",
    "croner": "^10.0.1",
    "hono": "4.13.13",
    "viem": "^2.57.11",
    "zod": "^4.6.7"
