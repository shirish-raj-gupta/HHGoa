# The API's settings during browser tests (pnpm test:e2e), used instead of the root .env: its own ports beside
# `pnpm dev`, an in-memory chain, a throwaway in-memory database seeded fresh on every start, no model and no
# outside services. A run costs nothing and starts from the same data every time. Simulated proofs and mock humans
# are on, as in development.
PORT=8799
PUBLIC_API_URL=http://localhost:8799
PUBLIC_WEB_URL=http://localhost:3100
PUBLIC_MERCHANT_URL=http://localhost:3100/business
PUBLIC_DEMO_URL=http://localhost:3102/stage
PUBLIC_ADMIN_URL=http://localhost:3103/admin
CHAIN=local
DATABASE_URL=pglite:memory
LLM_PROVIDER=offline
