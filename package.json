{
  "name": "receipts",
  "private": true,
  "type": "module",
  "description": "Receipts: verified, voice-first reviews of any purchase that AI agents pay to use and reviewers get paid for.",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "concurrently -k -n api,web,merchant,demo,admin -c blue,green,magenta,yellow,cyan \"pnpm --filter @receipts/api dev\" \"pnpm --filter @receipts/web dev\" \"pnpm --filter @receipts/merchant dev\" \"pnpm --filter @receipts/demo dev\" \"pnpm --filter @receipts/admin dev\"",
    "dev:api": "pnpm --filter @receipts/api dev",
    "dev:web": "pnpm --filter @receipts/web dev",
    "dev:merchant": "pnpm --filter @receipts/merchant dev",
    "dev:demo": "pnpm --filter @receipts/demo dev",
    "dev:admin": "pnpm --filter @receipts/admin dev",
    "dev:worker": "pnpm --filter @receipts/worker dev",
    "dev:mobile": "pnpm --filter @receipts/mobile start",
    "db:migrate": "pnpm --filter @receipts/db migrate",
    "db:seed": "pnpm --filter @receipts/db seed",
    "db:reset": "pnpm --filter @receipts/db reset",
    "categories:gen": "pnpm --filter @receipts/categories gen",
    "contracts:build": "pnpm --filter @receipts/contracts build",
    "contracts:test": "pnpm --filter @receipts/contracts test",
    "contracts:deploy": "pnpm --filter @receipts/contracts run deploy",
    "graph:setup": "pnpm --filter @receipts/engine graph:setup",
    "graph:wake": "pnpm --filter @receipts/engine graph:wake",
    "rehearse": "node scripts/rehearse.mjs",
    "agent": "pnpm --filter @receipts/mcp agent",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "pnpm -r test",
    "e2e": "pnpm --filter @receipts/api e2e",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "format": "prettier --write .",
    "build": "pnpm --filter @receipts/web --filter @receipts/merchant --filter @receipts/demo --filter @receipts/admin build",
    "smoke:mcp": "pnpm --filter @receipts/mcp smoke",
    "safe": "npx --yes sfw@2.0.6 pnpm",
    "security:scan": "node scripts/with-env.mjs npx --yes socket@1.11.1 scan create"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
