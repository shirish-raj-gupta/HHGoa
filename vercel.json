{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["cdg1"],
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "bindings": [{ "type": "service", "service": "api", "format": "url", "env": "API_INTERNAL_URL" }]
    },
    "merchant": {
      "root": "apps/merchant",
      "framework": "nextjs"
    },
    "demo": {
      "root": "apps/demo",
      "framework": "nextjs",
      "bindings": [{ "type": "service", "service": "api", "format": "url", "env": "RECEIPTS_API_URL" }]
    },
    "admin": {
      "root": "apps/admin",
      "framework": "nextjs"
    },
    "api": {
      "root": "apps/api",
      "framework": "hono",
      "entrypoint": "src/vercel.ts"
    }
  },
  "rewrites": [
    { "source": "/v1/(.*)", "destination": { "service": "api" } },
    { "source": "/mcp", "destination": { "service": "api" } },
    { "source": "/mcp/(.*)", "destination": { "service": "api" } },
    { "source": "/go/(.*)", "destination": { "service": "api" } },
    { "source": "/health", "destination": { "service": "api" } },
    { "source": "/business", "destination": { "service": "merchant" } },
    { "source": "/business/(.*)", "destination": { "service": "merchant" } },
    { "source": "/stage", "destination": { "service": "demo" } },
    { "source": "/stage/(.*)", "destination": { "service": "demo" } },
    { "source": "/admin", "destination": { "service": "admin" } },
    { "source": "/admin/(.*)", "destination": { "service": "admin" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ],
  "crons": [{ "path": "/v1/cron/1440", "schedule": "30 23 * * *" }]
}
